<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:JapaneseDictionary"
             xmlns:conv="clr-namespace:JapaneseDictionary.Converters"
             x:Class="JapaneseDictionary.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
            <conv:TabActiveBgConverter x:Key="TabActiveBgConverter" />
            <conv:TabActiveFgConverter x:Key="TabActiveFgConverter" />
            <conv:SvgPathToGeometryConverter x:Key="SvgPathToGeometryConverter" />
            <conv:HueFillConverter x:Key="HueFillConverter" />
            <conv:HueTextConverter x:Key="HueTextConverter" />
            <conv:HueBorderConverter x:Key="HueBorderConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
