<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0-android</TargetFrameworks>


        <OutputType>Exe</OutputType>
        <RootNamespace>JapaneseDictionary</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!-- Enable XAML source generation for faster build times and improved performance.
             This generates C# code from XAML at compile time instead of runtime inflation.
             To disable, remove this line.
             For individual files, you can override by setting Inflator metadata:
               <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
               <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
        <MauiXamlInflator>SourceGen</MauiXamlInflator>

        <!-- Display name -->
        <ApplicationTitle>Shirabe</ApplicationTitle>

        <!-- App Identifier -->
        <ApplicationId>com.aitorsansal.japanesedictionary</ApplicationId>

        <!-- Versions -->
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    </PropertyGroup>

    <!-- Android signing. keystore.local.props (gitignored, see keystore.local.props.template)
         supplies the keystore path, alias and passwords. It applies to Debug as well as Release,
         so both sign with the same certificate and switching configurations does not trigger
         an uninstall prompt. Without the file (fresh clone, fork) the default debug key is used. -->
    <Import Project="keystore.local.props" Condition="Exists('keystore.local.props')" />
    <PropertyGroup Condition="Exists('keystore.local.props') And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
        <AndroidKeyStore>True</AndroidKeyStore>
    </PropertyGroup>

    <!-- ONNX Runtime on Android needs these three fixes or libonnxruntime.so
         never makes it into the APK / never loads (learned the hard way in
         NihongoNoPractise). -->

    <!-- Fix 1: Microsoft.ML.OnnxRuntime's own targets file only adds its AAR
         (which contains libonnxruntime.so) as an AndroidLibrary item when
         $(AndroidApplication) == 'true'. In a SingleProject MAUI Android
         head that isn't guaranteed to be true yet at NuGet-import time. -->
    <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
        <AndroidApplication>true</AndroidApplication>
    </PropertyGroup>

    <!-- Fix 2: an explicit RID is required even in Debug, or NuGet's restore
         can skip OnnxRuntime's native asset entirely, surfacing at runtime as
         a crash on InferenceSession construction. android-arm64 covers real
         devices, android-x64 covers the typical emulator image. -->
    <PropertyGroup Condition="'$(Configuration)' == 'Debug' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
        <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'Release' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
        <AndroidLinkMode>SdkOnly</AndroidLinkMode>
        <!-- Profiled AOT: measured on a phone, cold start drops from ~1.24s to ~0.75s
             for +3MB. Full AOT (AndroidEnableProfiledAot=false) starts no faster and
             runs searches/page loads no faster, for +8MB. -->
        <RunAOTCompilation>true</RunAOTCompilation>
        <AndroidEnableProfiledAot>true</AndroidEnableProfiledAot>
        <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    </PropertyGroup>

    <!-- Fix 3: belt-and-suspenders — Fix 1 alone wasn't reliable enough in
         practice (a built APK still had no libonnxruntime.so under lib/).
         Add the AndroidLibrary item ourselves, unconditionally, straight from
         the package's own on-disk contents (needs GeneratePathProperty="true"
         on the PackageReference below to resolve $(PkgMicrosoft_ML_OnnxRuntime)). -->
    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And '$(PkgMicrosoft_ML_OnnxRuntime)' != ''">
        <AndroidLibrary Include="$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\android\native\onnxruntime.aar" Bind="false">
            <Link>onnxruntime.aar</Link>
        </AndroidLibrary>
    </ItemGroup>

    <ItemGroup>
        <!-- App Icon -->
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#201e1d" />

        <!-- Splash Screen: the icon's foreground glyph on the icon's own background colour -->
        <MauiSplashScreen Include="Resources\AppIcon\appiconfg.svg" Color="#201e1d" BaseSize="128,128" />

        <!-- Images -->
        <MauiImage Include="Resources\Images\*" />

        <!-- Custom Fonts -->
        <MauiFont Include="Resources\Fonts\*" />

        <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
        <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.27.0" GeneratePathProperty="true" />
        <PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
        <PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.11" />
        <!-- Native SQLite for Android. Pinned above the one bundle_green pulls in: lib 2.1.11 and
             older ship SQLite 3.49.1, affected by CVE-2025-6965 (GHSA-2m69-gcr7-jv3q, fixed in
             SQLite 3.50.2). 2.1.13 ships SQLite 3.53.3. -->
        <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3.android" Version="2.1.13" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\JapaneseDictionary.Core\JapaneseDictionary.Core.csproj" />
    </ItemGroup>

</Project>
