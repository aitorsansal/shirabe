<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="JapaneseDictionary.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:JapaneseDictionary.ViewModels"
    xmlns:res="clr-namespace:JapaneseDictionary.Resources.Localization"
    xmlns:services="clr-namespace:JapaneseDictionary.Services"
    xmlns:controls="clr-namespace:JapaneseDictionary.Controls"
    x:DataType="vm:SearchViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource ScreenBackgroundLight}, Dark={StaticResource ScreenBackgroundDark}}">

    <Grid RowDefinitions="Auto,*">

        <!--  Header  -->
        <VerticalStackLayout Grid.Row="0" Padding="16,54,16,0" Spacing="0" BackgroundColor="{AppThemeBinding Light={StaticResource ScreenBackgroundLight}, Dark={StaticResource ScreenBackgroundDark}}">
            <Grid ColumnDefinitions="*,Auto">
                <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                    <Label Text="辞書" FontFamily="NotoSerifJPBoldWordmark" FontSize="22" TextColor="{AppThemeBinding Light={StaticResource InkPrimaryLight}, Dark={StaticResource InkPrimaryDark}}" />
                    <Label Text="SHIRABE" FontFamily="ArchivoExtraBold" FontSize="11" CharacterSpacing="1.5" TextColor="{AppThemeBinding Light={StaticResource InkSecondaryLight}, Dark={StaticResource InkSecondaryDark}}" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center" Margin="0,0,-10,0">
                    <Button Text="{x:Static services:IconGlyphs.Bookmarks}"
                            Command="{Binding OpenListsCommand}"
                            SemanticProperties.Description="{x:Static res:AppResources.Common_Lists}"
                            Style="{StaticResource IconButtonStyle}" />
                    <Button Text="{x:Static services:IconGlyphs.Settings}"
                            Command="{Binding OpenSettingsCommand}"
                            SemanticProperties.Description="{x:Static res:AppResources.Common_Settings}"
                            Style="{StaticResource IconButtonStyle}" />
                </HorizontalStackLayout>
            </Grid>

            <BoxView HeightRequest="2" Margin="0,12,0,14" Color="{AppThemeBinding Light={StaticResource RuleMajorLight}, Dark={StaticResource RuleMajorDark}}" />

            <!--  Search bar  -->
            <Border StrokeThickness="1" Stroke="{AppThemeBinding Light={StaticResource RuleMajorLight}, Dark={StaticResource RuleMajorDark}}" Background="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" Padding="0">
                <Grid ColumnDefinitions="40,*,Auto,46" HeightRequest="46">
                    <Label Grid.Column="0" Text="🔍" TextColor="{AppThemeBinding Light={StaticResource InkSecondaryLight}, Dark={StaticResource InkSecondaryDark}}" FontSize="15" HorizontalOptions="Center" VerticalOptions="Center" />
                    <Entry
                        Grid.Column="1"
                        Text="{Binding Query}"
                        Placeholder="{Binding Placeholder}"
                        FontFamily="ArchivoRegular"
                        FontSize="17"
                        BackgroundColor="Transparent"
                        VerticalOptions="Center" />
                    <Button
                        Grid.Column="2"
                        Text="✕"
                        IsVisible="{Binding HasQuery}"
                        Command="{Binding ClearQueryCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light={StaticResource InkSecondaryLight}, Dark={StaticResource InkSecondaryDark}}"
                        FontSize="15"
                        WidthRequest="40"
                        Padding="0" />
                    <Button
                        Grid.Column="3"
                        Text="&#x270F;"
                        Command="{Binding OpenDrawCommand}"
                        BackgroundColor="{StaticResource DrawButtonFill}"
                        TextColor="White"
                        FontSize="17"
                        Padding="0" />
                </Grid>
            </Border>
        </VerticalStackLayout>

        <!--  Content  -->
        <ScrollView Grid.Row="1" Margin="0,14,0,0" IsVisible="{Binding ShowHomeContent}">
            <VerticalStackLayout Spacing="0" Padding="0,0,0,56">

                <!--  First launch after install or dictionary update  -->
                <VerticalStackLayout IsVisible="{Binding IsPreparingDictionary}" Padding="16,24" Spacing="12">
                    <ActivityIndicator IsRunning="{Binding IsPreparingDictionary}" HorizontalOptions="Start" />
                    <Label Text="{x:Static res:AppResources.Search_PreparingTitle}" FontFamily="ArchivoExtraBold" FontSize="19" TextColor="{AppThemeBinding Light={StaticResource InkPrimaryLight}, Dark={StaticResource InkPrimaryDark}}" />
                    <Label Text="{x:Static res:AppResources.Search_PreparingBody}" FontFamily="ArchivoRegular" FontSize="14" LineBreakMode="WordWrap" TextColor="{AppThemeBinding Light={StaticResource InkSecondaryLight}, Dark={StaticResource InkSecondaryDark}}" />
                </VerticalStackLayout>

                <!--  Recents  -->
                <VerticalStackLayout IsVisible="{Binding ShowRecents}" Padding="16,0,16,4" Spacing="0">
                    <Grid IsVisible="{Binding HasRecents}" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                        <Label Grid.Column="0" Text="{x:Static res:AppResources.Search_Recent}" FontFamily="ArchivoExtraBold" FontSize="11" CharacterSpacing="1.5" TextColor="{AppThemeBinding Light={StaticResource InkSecondaryLight}, Dark={StaticResource InkSecondaryDark}}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{x:Static res:AppResources.Search_Clear}" FontFamily="ArchivoExtraBold" FontSize="11" CharacterSpacing="1.5" TextColor="{AppThemeBinding Light={StaticResource InkMetaLight}, Dark={StaticResource InkMetaDark}}" VerticalOptions="Center" Padding="12,6,0,6" SemanticProperties.Description="{x:Static res:AppResources.Search_ClearDescription}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ClearRecentsCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <FlexLayout IsVisible="{Binding HasRecents}" BindableLayout.ItemsSource="{Binding Recents}" Wrap="Wrap" Direction="Row" JustifyContent="Start">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:RecentWordChip">
                                <Border StrokeThickness="1" Stroke="{AppThemeBinding Light={StaticResource RuleMajorLight}, Dark={StaticResource RuleMajorDark}}" Margin="0,0,6,6" Padding="11,7" FlexLayout.Shrink="0">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SearchViewModel}}, Path=OpenRecentCommand}" CommandParameter="{Binding EntryId}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding Word}" FontFamily="NotoSerifJPSemiBold" LineHeight="0.85" FontSize="15" TextColor="{AppThemeBinding Light={StaticResource InkPrimaryLight}, Dark={StaticResource InkPrimaryDark}}" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <BoxView IsVisible="{Binding HasRecents}" HeightRequest="1" Margin="0,18,0,14" Color="{AppThemeBinding Light={StaticResource RuleMinorLight}, Dark={StaticResource RuleMinorDark}}" />
                    <Label Text="{x:Static res:AppResources.Search_Try}" FontFamily="ArchivoExtraBold" FontSize="11" CharacterSpacing="1.5" TextColor="{AppThemeBinding Light={StaticResource InkSecondaryLight}, Dark={StaticResource InkSecondaryDark}}" Margin="0,0,0,8" />
                    <Label FontFamily="ArchivoRegular" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource InkSecondaryLight}, Dark={StaticResource InkSecondaryDark}}" LineBreakMode="WordWrap">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{x:Static res:AppResources.Search_HintType}" />
                                <Span Text="taberu" FontFamily="ArchivoSemiBold" TextColor="{AppThemeBinding Light={StaticResource InkPrimaryLight}, Dark={StaticResource InkPrimaryDark}}" />
                                <Span Text="{x:Static res:AppResources.Search_HintOr}" />
                                <Span Text="eat" FontFamily="ArchivoSemiBold" TextColor="{AppThemeBinding Light={StaticResource InkPrimaryLight}, Dark={StaticResource InkPrimaryDark}}" />
                                <Span Text="{x:Static res:AppResources.Search_HintMiddle}" />
                                <Span Text="食べた" FontFamily="ArchivoSemiBold" TextColor="{AppThemeBinding Light={StaticResource InkPrimaryLight}, Dark={StaticResource InkPrimaryDark}}" />
                                <Span Text="{x:Static res:AppResources.Search_HintEnd}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <CollectionView Grid.Row="1" Margin="0,14,0,0" IsVisible="{Binding HasQuery}" ItemsSource="{Binding Results}" SelectionMode="None">
            <CollectionView.Header>
                <Grid IsVisible="{Binding HasQuery}" ColumnDefinitions="*,Auto" Padding="16,0,16,8">
                    <Label Grid.Column="0" Text="{Binding ResultLabel}" FontFamily="ArchivoExtraBold" FontSize="11" CharacterSpacing="1.5" TextColor="{AppThemeBinding Light={StaticResource InkSecondaryLight}, Dark={StaticResource InkSecondaryDark}}" />
                    <Label Grid.Column="1" Text="{Binding ResultCountText}" FontFamily="ArchivoSemiBold" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource InkMetaLight}, Dark={StaticResource InkMetaDark}}" />
                </Grid>
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:SearchResultRow">
                    <controls:EntryRowView Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SearchViewModel}}, Path=OpenResultCommand}" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.Footer>
                <VerticalStackLayout Spacing="0" Padding="0,0,0,56">
                    <VerticalStackLayout IsVisible="{Binding IsEmpty}" Padding="16,24" Spacing="12">
                        <Label Text="{x:Static res:AppResources.Search_NoMatches}" FontFamily="ArchivoExtraBold" FontSize="19" TextColor="{AppThemeBinding Light={StaticResource InkPrimaryLight}, Dark={StaticResource InkPrimaryDark}}" />
                        <Label FontFamily="ArchivoRegular" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource InkSecondaryLight}, Dark={StaticResource InkSecondaryDark}}" LineBreakMode="WordWrap">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static res:AppResources.Search_NoMatchesPrefix}" />
                                    <Span Text="{Binding Query}" />
                                    <Span Text="{x:Static res:AppResources.Search_NoMatchesSuffix}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Button
                            Text="{x:Static res:AppResources.Search_DrawKanji}"
                            Command="{Binding OpenDrawCommand}"
                            BackgroundColor="{StaticResource DrawButtonFill}"
                            TextColor="White"
                            FontFamily="ArchivoExtraBold"
                            FontSize="13"
                            HorizontalOptions="Start"
                            CornerRadius="0" />
                    </VerticalStackLayout>

                    <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Margin="0,20,0,0" />
                </VerticalStackLayout>
            </CollectionView.Footer>
        </CollectionView>
    </Grid>
</ContentPage>
