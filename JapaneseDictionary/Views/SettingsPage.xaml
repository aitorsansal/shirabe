<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="JapaneseDictionary.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:JapaneseDictionary.ViewModels"
    xmlns:res="clr-namespace:JapaneseDictionary.Resources.Localization"
    x:DataType="vm:SettingsViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource ScreenBackgroundLight}, Dark={StaticResource ScreenBackgroundDark}}">

    <ContentPage.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="Label">
            <Setter Property="FontFamily" Value="ArchivoExtraBold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="CharacterSpacing" Value="1" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkSecondaryLight}, Dark={StaticResource InkSecondaryDark}}" />
        </Style>
        <Style x:Key="BodyStyle" TargetType="Label">
            <Setter Property="FontFamily" Value="ArchivoRegular" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkGlossBodyLight}, Dark={StaticResource InkGlossBodyDark}}" />
        </Style>
        <Style x:Key="ActionLinkStyle" TargetType="Label">
            <Setter Property="FontFamily" Value="ArchivoSemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="0,10" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ReadingAccentLight}, Dark={StaticResource ReadingAccentDark}}" />
        </Style>
        <Style x:Key="SegmentStyle" TargetType="Border">
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource RuleMajorLight}, Dark={StaticResource RuleMajorDark}}" />
            <Setter Property="Padding" Value="0,11" />
        </Style>
        <Style x:Key="SegmentLabelStyle" TargetType="Label">
            <Setter Property="FontFamily" Value="ArchivoExtraBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CharacterSpacing" Value="1" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkSecondaryLight}, Dark={StaticResource InkSecondaryDark}}" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!--  Header  -->
        <VerticalStackLayout Grid.Row="0" Padding="16,50,16,0" Spacing="0" BackgroundColor="{AppThemeBinding Light={StaticResource ScreenBackgroundLight}, Dark={StaticResource ScreenBackgroundDark}}">
            <Button
                Text="{x:Static res:AppResources.Common_Back}"
                Command="{Binding GoBackCommand}"
                BackgroundColor="Transparent"
                TextColor="{AppThemeBinding Light={StaticResource InkSecondaryLight}, Dark={StaticResource InkSecondaryDark}}"
                FontFamily="ArchivoExtraBold"
                FontSize="11"
                CharacterSpacing="1"
                HorizontalOptions="Start"
                Padding="0,6"
                MinimumHeightRequest="36" />
            <BoxView HeightRequest="2" Color="{AppThemeBinding Light={StaticResource RuleMajorLight}, Dark={StaticResource RuleMajorDark}}" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="0" Padding="16,18,16,40">

                <Label Text="{x:Static res:AppResources.Common_Settings}" FontFamily="ArchivoExtraBold" FontSize="26" TextColor="{AppThemeBinding Light={StaticResource InkPrimaryLight}, Dark={StaticResource InkPrimaryDark}}" />

                <!--  Appearance  -->
                <VerticalStackLayout Spacing="8" Margin="0,24,0,0">
                    <Label Text="{x:Static res:AppResources.Settings_Appearance}" Style="{StaticResource SectionTitleStyle}" />
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource RuleMinorLight}, Dark={StaticResource RuleMinorDark}}" />
                    <Label Text="{x:Static res:AppResources.Settings_Theme}" Style="{StaticResource BodyStyle}" Margin="0,4,0,2" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="-1">
                        <Border Grid.Column="0" Style="{StaticResource SegmentStyle}" SemanticProperties.Description="{x:Static res:AppResources.Settings_ThemeSystemDescription}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SetThemeCommand}" CommandParameter="System" />
                            </Border.GestureRecognizers>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsThemeSystem}" Value="True">
                                    <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource InkPrimaryLight}, Dark={StaticResource InkPrimaryDark}}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Label Text="{x:Static res:AppResources.Settings_ThemeSystem}" Style="{StaticResource SegmentLabelStyle}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsThemeSystem}" Value="True">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ScreenBackgroundLight}, Dark={StaticResource ScreenBackgroundDark}}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource SegmentStyle}" SemanticProperties.Description="{x:Static res:AppResources.Settings_ThemeLightDescription}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SetThemeCommand}" CommandParameter="Light" />
                            </Border.GestureRecognizers>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsThemeLight}" Value="True">
                                    <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource InkPrimaryLight}, Dark={StaticResource InkPrimaryDark}}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Label Text="{x:Static res:AppResources.Settings_ThemeLight}" Style="{StaticResource SegmentLabelStyle}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsThemeLight}" Value="True">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ScreenBackgroundLight}, Dark={StaticResource ScreenBackgroundDark}}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource SegmentStyle}" SemanticProperties.Description="{x:Static res:AppResources.Settings_ThemeDarkDescription}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SetThemeCommand}" CommandParameter="Dark" />
                            </Border.GestureRecognizers>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsThemeDark}" Value="True">
                                    <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource InkPrimaryLight}, Dark={StaticResource InkPrimaryDark}}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Label Text="{x:Static res:AppResources.Settings_ThemeDark}" Style="{StaticResource SegmentLabelStyle}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsThemeDark}" Value="True">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ScreenBackgroundLight}, Dark={StaticResource ScreenBackgroundDark}}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                    </Grid>
                </VerticalStackLayout>

                <!--  Language. Language names are endonyms, so they aren't translated.  -->
                <VerticalStackLayout Spacing="8" Margin="0,24,0,0">
                    <Label Text="{x:Static res:AppResources.Settings_Language}" Style="{StaticResource BodyStyle}" Margin="0,0,0,2" />
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="-1">
                        <Border Grid.Column="0" Style="{StaticResource SegmentStyle}" SemanticProperties.Description="{x:Static res:AppResources.Settings_LanguageSystemDescription}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SetLanguageCommand}" CommandParameter="" />
                            </Border.GestureRecognizers>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsLanguageSystem}" Value="True">
                                    <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource InkPrimaryLight}, Dark={StaticResource InkPrimaryDark}}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Label Text="{x:Static res:AppResources.Settings_LanguageSystem}" Style="{StaticResource SegmentLabelStyle}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsLanguageSystem}" Value="True">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ScreenBackgroundLight}, Dark={StaticResource ScreenBackgroundDark}}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource SegmentStyle}" SemanticProperties.Description="English">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SetLanguageCommand}" CommandParameter="en" />
                            </Border.GestureRecognizers>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsLanguageEnglish}" Value="True">
                                    <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource InkPrimaryLight}, Dark={StaticResource InkPrimaryDark}}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Label Text="ENGLISH" Style="{StaticResource SegmentLabelStyle}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsLanguageEnglish}" Value="True">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ScreenBackgroundLight}, Dark={StaticResource ScreenBackgroundDark}}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource SegmentStyle}" SemanticProperties.Description="Español">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SetLanguageCommand}" CommandParameter="es" />
                            </Border.GestureRecognizers>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsLanguageSpanish}" Value="True">
                                    <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource InkPrimaryLight}, Dark={StaticResource InkPrimaryDark}}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Label Text="ESPAÑOL" Style="{StaticResource SegmentLabelStyle}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsLanguageSpanish}" Value="True">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ScreenBackgroundLight}, Dark={StaticResource ScreenBackgroundDark}}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                        <Border Grid.Column="3" Style="{StaticResource SegmentStyle}" SemanticProperties.Description="Català">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SetLanguageCommand}" CommandParameter="ca" />
                            </Border.GestureRecognizers>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsLanguageCatalan}" Value="True">
                                    <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource InkPrimaryLight}, Dark={StaticResource InkPrimaryDark}}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Label Text="CATALÀ" Style="{StaticResource SegmentLabelStyle}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsLanguageCatalan}" Value="True">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ScreenBackgroundLight}, Dark={StaticResource ScreenBackgroundDark}}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                    </Grid>
                    <Label Text="{x:Static res:AppResources.Settings_LanguageNote}" Style="{StaticResource BodyStyle}" FontSize="12" Margin="0,2,0,0" />
                </VerticalStackLayout>

                <!--  Audio  -->
                <VerticalStackLayout Spacing="8" Margin="0,28,0,0">
                    <Label Text="{x:Static res:AppResources.Settings_Audio}" Style="{StaticResource SectionTitleStyle}" />
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource RuleMinorLight}, Dark={StaticResource RuleMinorDark}}" />
                    <Label Text="{Binding VoiceStatusText}" Style="{StaticResource BodyStyle}" Margin="0,4,0,0" />
                    <VerticalStackLayout IsVisible="{Binding ShowEngineChoice}" Spacing="0" Margin="0,6,0,0">
                        <Label Text="{x:Static res:AppResources.Settings_VoiceEngine}" Style="{StaticResource BodyStyle}" Margin="0,0,0,6" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding EngineChoices}" Spacing="0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:EngineChoiceRow">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="0,10" Background="Transparent">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SettingsViewModel}}, Path=SelectEngineCommand}" CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                        <!--  Square radio mark, matching the add-to-list sheet's check boxes.  -->
                                        <Border Grid.Column="0" WidthRequest="20" HeightRequest="20" StrokeThickness="2" Padding="4" VerticalOptions="Start" Margin="0,1,0,0"
                                                Stroke="{AppThemeBinding Light={StaticResource InkSecondaryLight}, Dark={StaticResource InkSecondaryDark}}">
                                            <BoxView IsVisible="{Binding IsSelected}" Color="{AppThemeBinding Light={StaticResource ReadingAccentLight}, Dark={StaticResource ReadingAccentDark}}" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="{Binding Label}" FontFamily="ArchivoSemiBold" FontSize="15" TextColor="{AppThemeBinding Light={StaticResource InkPrimaryLight}, Dark={StaticResource InkPrimaryDark}}" />
                                            <Label Text="{Binding Note}" IsVisible="{Binding Note, Converter={StaticResource StringNotEmptyConverter}}" Style="{StaticResource BodyStyle}" FontSize="12" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                    <Label Text="{x:Static res:AppResources.Settings_TestVoice}" Style="{StaticResource ActionLinkStyle}" IsVisible="{Binding IsVoiceReady}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding TestVoiceCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Text="{x:Static res:AppResources.Settings_OpenTts}" Style="{StaticResource ActionLinkStyle}" Padding="0,0,0,10">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenTtsSettingsCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </VerticalStackLayout>

                <!--  Data  -->
                <VerticalStackLayout Spacing="8" Margin="0,20,0,0">
                    <Label Text="{x:Static res:AppResources.Settings_Data}" Style="{StaticResource SectionTitleStyle}" />
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource RuleMinorLight}, Dark={StaticResource RuleMinorDark}}" />
                    <Label Text="{Binding HistorySummary}" Style="{StaticResource BodyStyle}" Margin="0,4,0,0" />
                    <Label Text="{x:Static res:AppResources.Settings_ClearHistory}" Style="{StaticResource ActionLinkStyle}" IsVisible="{Binding HasHistory}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ClearHistoryCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </VerticalStackLayout>

                <!--  Study  -->
                <VerticalStackLayout Spacing="8" Margin="0,20,0,0">
                    <Label Text="{x:Static res:AppResources.Settings_Study}" Style="{StaticResource SectionTitleStyle}" />
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource RuleMinorLight}, Dark={StaticResource RuleMinorDark}}" />
                    <Border StrokeThickness="1" Stroke="{AppThemeBinding Light={StaticResource RuleMajorLight}, Dark={StaticResource RuleMajorDark}}" Padding="14,12" Margin="0,6,0,0" SemanticProperties.Description="{x:Static res:AppResources.Settings_PracticeLinkDescription}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenPracticeAppCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="Nihongo no Practise" FontFamily="ArchivoExtraBold" FontSize="15" TextColor="{AppThemeBinding Light={StaticResource InkPrimaryLight}, Dark={StaticResource InkPrimaryDark}}" />
                                <Label Text="{x:Static res:AppResources.Settings_PracticeDescription}" Style="{StaticResource BodyStyle}" FontSize="13" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="›" FontFamily="ArchivoBold" FontSize="20" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource InkMetaLight}, Dark={StaticResource InkMetaDark}}" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!--  About  -->
                <VerticalStackLayout Spacing="8" Margin="0,28,0,0">
                    <Label Text="{x:Static res:AppResources.Settings_About}" Style="{StaticResource SectionTitleStyle}" />
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource RuleMinorLight}, Dark={StaticResource RuleMinorDark}}" />
                    <Label Text="{Binding VersionText}" Style="{StaticResource BodyStyle}" Margin="0,4,0,0" />
                    <Label Text="{x:Static res:AppResources.Settings_OfflineNote}" Style="{StaticResource BodyStyle}" />
                    <Label Text="{x:Static res:AppResources.Settings_Licences}" Style="{StaticResource ActionLinkStyle}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenAboutCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
