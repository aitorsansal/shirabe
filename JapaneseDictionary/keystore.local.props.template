<Project>
	<!--
	Copy this file to "keystore.local.props" (same directory) and fill in the real values.
	"keystore.local.props" is in .gitignore and must never be committed.
	Keep the keystore (keystore\japanesedictionary.keystore) and its passwords in a password
	manager, never in git or in plain chat. See the README for the keytool command that creates it.

	Without keystore.local.props the project still builds: Android falls back to the default
	debug keystore, which is what a fresh clone or a fork should use.

	For a PKCS12 keystore (the default since JDK 9) the key password is the same as the store
	password, so use the same value in both places.
	-->
	<PropertyGroup>
		<AndroidSigningKeyStore>keystore\japanesedictionary.keystore</AndroidSigningKeyStore>
		<AndroidSigningKeyAlias>japanesedictionary</AndroidSigningKeyAlias>
		<AndroidSigningStorePass>REPLACE_ME</AndroidSigningStorePass>
		<AndroidSigningKeyPass>REPLACE_ME</AndroidSigningKeyPass>
	</PropertyGroup>
</Project>
